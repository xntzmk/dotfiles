    "defaultProfile": "{574e775e-4f2a-5b96-ac1e-a2962a402336}",
    "keybindings":
    [
        {
            "id": "Terminal.CopyToClipboard",
            "keys": "ctrl+c"
        },
        {
            "id": null,
            "keys": "ctrl+shift+tab"
        },
        {
            "id": null,
            "keys": "ctrl+tab"
        },
        {
            "id": "Terminal.OpenNewTab",
            "keys": "ctrl+t"
        },
        {
            "id": "Terminal.FindText",
            "keys": "ctrl+shift+f"
        },
        {
            "id": "Terminal.PasteFromClipboard",
            "keys": "ctrl+v"
        },
        {
            "id": null,
            "keys": "ctrl+comma"
        },
        {
            "id": "Terminal.DuplicatePaneAuto",
            "keys": "alt+shift+d"
        },
        {
            "id": null,
            "keys": "ctrl+shift+t"
        },
        {
            "id": "Terminal.PrevTab",
            "keys": "ctrl+shift+comma"
        },
        {
            "id": "Terminal.NextTab",
            "keys": "ctrl+shift+period"
        }
    ],
